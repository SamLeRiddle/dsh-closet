{
  "name": "dsh-closet",
  "version": "0.1.3",
  "description": "Collect the scattered third-party plugin entries in the sidebar footer into one collapsible row named 匣.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/ui.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/ui.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "docs/images/*.png",
    "tests/*.test.mjs"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sidebar",
    "closet"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  }
}
